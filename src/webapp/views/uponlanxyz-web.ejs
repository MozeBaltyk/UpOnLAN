      }).join('') + '<td><select class="form-control form-control-sm" style="min-width:110px" data-host="disk_hint_type" aria-label="Host ' + (i + 1) + ' hint type">' +
      '<option value="wwn"' + (diskHint.type === 'wwn' ? ' selected' : '') + '>WWN</option>' +
      '<option value="serial"' + (diskHint.type === 'serial' ? ' selected' : '') + '>Serial</option>' +
      '<option value="deviceName"' + (diskHint.type === 'deviceName' ? ' selected' : '') + '>Device name</option></select></td>' +
      '<td><input class="form-control form-control-sm" data-host="disk_hint_value" value="' + okdAttr(diskHint.value) + '" placeholder="' + okdDiskHintPlaceholder(diskHint.type) + '" aria-label="Host ' + (i + 1) + ' root device hint value"></td></tr>';
