let assetCategoryFilter = 'all';

function buildAssetUrl(baseUrl, assetPath) {
  return String(baseUrl || '').replace(/\/+$/, '') + assetPath;
}

function fallbackCopyText(text) {
  const input = document.createElement('textarea');
  input.value = text;
  input.setAttribute('readonly', 'readonly');
  input.style.position = 'absolute';
  input.style.left = '-9999px';
  document.body.appendChild(input);
  input.select();
  document.execCommand('copy');
  document.body.removeChild(input);
  showToast('Copied URL', 'success');
}

function copyText(text) {
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text)
      .then(function () { showToast('Copied URL', 'success'); })
      .catch(function () { fallbackCopyText(text); });
    return;
  }
  fallbackCopyText(text);
}

function openProvisioningFromAssets(relativePath) {
  pendingProvisioningOpen = relativePath;
  pendingProvisioningReset = false;
  setActiveNav('navconfig');
  renderconfig();
}

function setAssetFilter(filter) {
  assetCategoryFilter = filter || 'all';
  applyAssetFilter();
}

function applyAssetFilter() {
  if (!$('#boot-assets-card-group').length) return;
  const showBoot = !['provisioning', 'okd'].includes(assetCategoryFilter);
  const showProvisioning = !['boot', 'okd'].includes(assetCategoryFilter);
  const showOkd = !['boot', 'provisioning'].includes(assetCategoryFilter);
  $('#boot-assets-card-group').toggle(showBoot);
  $('#provisioning-assets-card').toggle(showProvisioning);
  $('#okd-assets-card').toggle(showOkd);
  $('[data-asset-filter]').removeClass('active');
  $('[data-asset-filter="' + assetCategoryFilter + '"]').addClass('active');
}

