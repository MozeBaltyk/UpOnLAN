function editorModeForFile(filename) {
  const baseName = String(filename || '').split('/').pop();
  return ['user-data', 'meta-data', 'network-config'].includes(baseName) ? 'ace/mode/yaml' : 'ace/mode/sh';
}

function renderEditorFile(filename, response, buttons, toolbar) {
  $('#configcontent').empty();
  $('#configcontent').append(`
  <div class="container">
    <div class="row">
      <div class="col">
        <h4 class="m-3 mb-0 text-break">${filename}</h4>
      </div>
      <div class="col">
        ${buttons}
      </div>
    </div>
    ${toolbar || ''}
  </div>
  <div id="editor" style="height:100%;width:100%"></div>`);
  editor = ace.edit('editor');
  const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
  const aceTheme = currentTheme === 'dark' ? 'ace/theme/monokai' : 'ace/theme/chrome';
  editor.setTheme(aceTheme);
  editor.session.setMode(editorModeForFile(filename));
  editor.$blockScrolling = Infinity;
  editor.setOptions({
    readOnly: false,
  });
  editor.setValue(response, -1);
}

