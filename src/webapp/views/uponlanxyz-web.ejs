// Handle document content response
socket.on('docs:get:response', function({ filename, content }) {
  // content is already server-rendered HTML (docServices.getDocContent).
  // Inject directly: re-parsing HTML as markdown mangles code blocks that
  // contain blank lines (e.g. '# comment' lines re-render as <h1> headings).
  $('#doc-viewer').html(content);
});

// Internal doc links: [foo](path/to/foo.md) navigate through the viewer.
// The server strips leading ../ and appends .md if missing; we just decode
// %20-style encoding and drop any #anchor before emitting. Delegated on
// document because #doc-viewer is created lazily (first docs:list response),
// so binding it at load time would attach to nothing.
$(document).on('click', '#doc-viewer a', function(e) {
  const href = $(this).attr('href');
  if (href && href.split('#')[0].endsWith('.md')) {
    e.preventDefault();
    loaddoc(decodeURIComponent(href.split('#')[0]));
  }
});

//// Render OKD profile page ////
const OKD_RELEASE = '<%= okdRelease %>';
const OKD_MAX_WORKERS = <%= okdMaxWorkers %>;
let okdProfiles = [];
let okdProfile = null;
let okdExistingId = null;
let okdRevision = null;
let okdBaseline = '';
let okdToolStatus = null;
let okdSavedRelease = null;
let okdToolPoll = null;
let okdToolEpoch = 0;
let okdToolError = '';
let okdPullSecretStatus = null;
let okdPullSecretSaving = false;
let okdPullSecretMessage = '';
let okdPullSecretMessageType = 'secondary';
let okdGenerationReady = false;
let okdActiveTab = 'profiles';
let okdJobStatus = { current: null, blocking: null, history: [] };
let okdPreflight = { ready: false, errors: [{ message: 'Select and save a profile.' }] };
let okdJobLog = '';
let okdJobPoll = null;
let okdVersions = [];
let okdConfigs = null;
let okdConfigStatus = '';
let okdPageActive = false;
let okdViewEpoch = 0;
let okdEditorEpoch = 0;
let okdModalOpen = false;
let okdGenerateContext = null;
let okdGenerateEpoch = 0;
const okdDetailsOpen = {};
let okdCertificateInspection = null;
let okdCertificateMessage = '';
let okdCertificateInspecting = false;
let okdCertificateEpoch = 0;
let okdAdditionalCertificates = [];
let okdCaValidation = null;
let okdCaEpoch = 0;

function okdCertificateDetails(cert) {
  if (!cert || !cert.metadata) return '<p>Certificate status has not been inspected.</p>';
  const metadata = cert.metadata; const leaf = metadata.chain && metadata.chain[0] || {};
  const tags = [metadata.localCertificateMatch ? 'default certificate' : 'custom certificate', leaf.selfSigned ? 'self-signed' : 'CA-issued',
    metadata.validity === 'current' ? 'valid' : metadata.validity === 'not_yet_valid' ? 'not yet valid' : 'expired',
    metadata.hostnameMatch ? 'name/address matches' : 'name/address does not match', metadata.systemTrusted ? 'system trusted' : 'not system trusted',
    okdProfile && (okdProfile.asset_certificate_bundle && !metadata.storedMismatch || metadata.additionalCaMatch) ? 'included in additionalTrustBundle' : 'not included in additionalTrustBundle'];
  const chain = (metadata.chain || []).map(function(item, index) {
    return `<li><strong>${index ? 'Issuer' : 'Leaf'}:</strong> ${okdAttr(item.subject)} · ${item.ca ? 'CA certificate' : 'end-entity certificate'}<br>Issuer: ${okdAttr(item.issuer)}<br>Valid ${okdAttr(item.validFrom)} to ${okdAttr(item.validTo)}<br>SHA-256: <code>${okdAttr(item.fingerprint256)}</code></li>`;
  }).join('');
  return `<div class="mb-2">${tags.map(function(tag) { return `<span class="badge badge-secondary mr-1">${okdAttr(tag)}</span>`; }).join('')}</div>
    ${metadata.endpointVerified === false ? '<div class="alert alert-warning py-2"><strong>Endpoint not verified:</strong> using the validated local deployment certificate because the live endpoint could not be reached.</div>' : ''}<dl class="small text-break"><dt>Subject and issuer</dt><dd>${okdAttr(leaf.subject)}<br>${okdAttr(leaf.issuer)}</dd><dt>Subject alternative names</dt><dd>${okdAttr(leaf.subjectAltName || 'None')}</dd>
    <dt>Valid from / valid to</dt><dd>${okdAttr(leaf.validFrom)} / ${okdAttr(leaf.validTo)}</dd><dt>SHA-256 fingerprint</dt><dd><code>${okdAttr(leaf.fingerprint256)}</code></dd>
    <dt>Inspected endpoint</dt><dd>${okdAttr(metadata.hostname)} (${okdAttr(metadata.address)})</dd><dt>Chain details</dt><dd><ol class="pl-3">${chain}</ol></dd><dt>Inspection/trust warnings</dt><dd>${okdAttr(metadata.authorizationError || 'None')}<br>${okdAttr(metadata.rootfsVerification || '')}${metadata.storedMismatch ? '<br><strong>Stored and presented certificates do not match.</strong>' : ''}</dd></dl>
    ${(metadata.storedMismatch || (!metadata.systemTrusted && !metadata.localCertificateMatch && !metadata.additionalCaMatch)) && cert.caPem ? '<button id="okd-trust-inspected" type="button" class="btn btn-warning btn-sm">Use inspected certificate trust</button>' : ''}`;
}

function okdCertificateStatus() {
  if (okdCertificateInspecting) return { state: 'secondary', text: 'Inspecting certificate…' };
  const metadata = okdCertificateInspection && okdCertificateInspection.metadata;
  if (!metadata) return { state: okdCertificateMessage ? 'danger' : 'secondary', text: okdCertificateMessage || 'Not inspected' };
  if (metadata.storedMismatch) return { state: 'danger', text: 'Certificate changed; resolve before saving' };
  if (metadata.endpointVerified === false) return { state: 'warning', text: 'Inspected · see certificate details' };
  const trusted = metadata.systemTrusted || metadata.localCertificateMatch || metadata.additionalCaMatch;
  const ready = metadata.validity === 'current' && metadata.hostnameMatch && trusted;
  return { state: ready ? 'success' : 'warning', text: `${metadata.validity === 'current' ? 'Inspected' : metadata.validity} · ${metadata.hostnameMatch ? 'name matches' : 'name mismatch'} · ${trusted ? 'trusted' : 'confirmation required'}` };
}

function okdCertificateSummary() { return okdCertificateStatus().text; }

function okdUpdateCertificateStatus() {
  const status = okdCertificateStatus();
  $('#okd-certificate-status').text(status.text).removeClass('alert-secondary alert-success alert-warning alert-danger').addClass(`alert-${status.state}`);
}

function okdInspectCertificate(profile, callback) {
  const epoch = okdViewEpoch; const token = ++okdCertificateEpoch; const assetUrl = profile.asset_url;
  okdCertificateInspecting = true; okdUpdateCertificateStatus();
  socket.timeout(15000).emit('okd:certificates:inspect', { assetUrl: assetUrl, storedPem: profile.asset_certificate_bundle || '', additionalPem: profile.additional_ca_bundle || '' }, function(err, result) {
    if (!okdPageActive || epoch !== okdViewEpoch || token !== okdCertificateEpoch || assetUrl !== okdReadForm().asset_url) return;
    okdCertificateInspecting = false;
    okdCertificateInspection = !err && result && result.ok ? result.data : null;
    okdCertificateMessage = err || !result ? 'Certificate inspection was not acknowledged.' : (result.ok ? '' : result.message);
    okdUpdateCertificateStatus();
    $('#okd-certificate-details').prop('disabled', !okdCertificateInspection);
    if (callback) callback(err || !result ? { ok: false, message: okdCertificateMessage } : result);
  });
}

function okdPemBlocks(pem) {
  return (pem || '').match(/-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----\s*/g) || [];
}

function okdMergeAdditionalBundle(currentPem, currentCertificates, added) {
  const entries = [];
  function append(pem, certificates) {
    const blocks = okdPemBlocks(pem);
    certificates.forEach(function(cert, index) { if (blocks[index]) entries.push({ cert: cert, pem: blocks[index].trim() + '\n' }); });
  }
  append(currentPem || '', currentCertificates || []); append(added.pem || '', added.certificates || []);
  const unique = new Map(); entries.forEach(function(entry) { unique.set(entry.cert.fingerprint256, entry); });
  const normalized = Array.from(unique.values()).sort(function(a, b) { return a.cert.fingerprint256.localeCompare(b.cert.fingerprint256); });
  return { pem: normalized.map(function(entry) { return entry.pem; }).join(''), certificates: normalized.map(function(entry) { return entry.cert; }) };
}

function okdAdditionalCaRows() {
  if (!okdAdditionalCertificates.length) return '<p class="small text-muted mb-2">No additional CA certificates.</p>';
  return `<ul class="list-group mb-2">${okdAdditionalCertificates.map(function(cert) { return `<li class="list-group-item py-2 d-flex justify-content-between align-items-start"><span class="small text-break"><strong>${okdAttr(cert.subject)}</strong><br>${okdAttr(cert.validity)} · valid to ${okdAttr(cert.validTo)}<br><code>${okdAttr(cert.fingerprint256)}</code></span><button type="button" class="btn btn-outline-danger btn-sm ml-2" data-okd-remove-ca="${okdAttr(cert.fingerprint256)}" aria-label="Remove CA certificate ${okdAttr(cert.subject)}">Remove</button></li>`; }).join('')}</ul>`;
}

function okdLoadAdditionalCertificates(profile) {
  const epoch = okdViewEpoch; const pem = profile.additional_ca_bundle || '';
  if (!pem) { okdAdditionalCertificates = []; return; }
  socket.timeout(15000).emit('okd:certificates:validate', { pem: pem }, function(err, result) {
    if (!okdPageActive || epoch !== okdViewEpoch || profile !== okdProfile || err || !result || !result.ok) return;
    profile.additional_ca_bundle = result.data.pem; okdAdditionalCertificates = result.data.certificates; okdRefreshView();
  });
}

function okdAttr(value) {
  const chars = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) { return chars[c]; });
}

function okdDiskHintParts(hint) {
  const match = /^(wwn|serial|deviceName):(.*)$/.exec(hint || '');
  return match ? { type: match[1], value: match[2] } : { type: 'deviceName', value: '' };
}

function okdDiskHintPlaceholder(type) {
  return type === 'wwn' ? '0x5000c500aabbccdd' : (type === 'serial' ? 'ABC-123' : '/dev/vda');
}

function okdSnapshot(profile) {
  const copy = Object.assign({}, profile);
  delete copy.revision;
  delete copy.saved_at;
  return JSON.stringify(copy);
}

function okdMarkClean(profile) {
  okdBaseline = okdSnapshot(profile);
}

function okdListedProfileId(profiles, selectedId) {
  return profiles.some(function(profile) { return profile.id === selectedId; }) ? selectedId : (profiles[0] ? profiles[0].id : null);
}

function okdConfirmDiscard() {
  return !$('#okd-id').length || okdSnapshot(okdReadForm()) === okdBaseline || confirm('Discard unsaved OKD profile changes?');
}

function okdNewProfile() {
  return {
    id: 'lab-okd', release: OKD_RELEASE, platform: 'none', topology: 'sno',
    cluster_name: 'lab', base_domain: 'example.com', machine_network: '192.168.7.0/24', rendezvous_ip: '192.168.7.10',
    ssh_public_key: '', worker_count: 0, api_vip: '', ingress_vip: '',
    boot_mode: 'pxe', asset_url: 'https://192.168.7.1:8443/', asset_certificate_bundle: '', additional_ca_bundle: '',
    hosts: [{ hostname: 'master-0', role: 'control-plane', mac: '02:00:00:00:00:10', ipv4: '192.168.7.10', interface: 'eno1', disk_hint: 'deviceName:/dev/vda' }]
  };
}

function okdNormalizeProfile(profile) {
  return Object.assign({}, okdNewProfile(), profile, { hosts: profile.hosts || [] });
}

function okdDesiredRoles(profile) {
  const cp = profile.topology === 'sno' ? 1 : 3;
  const workers = profile.topology === 'standard' ? Math.min(OKD_MAX_WORKERS, Math.max(1, Number(profile.worker_count) || 1)) : 0;
  return Array(cp).fill('control-plane').concat(Array(workers).fill('worker'));
}

function okdFitHosts(profile) {
  const old = profile.hosts || [];
  profile.hosts = okdDesiredRoles(profile).map(function(role, i) {
    return Object.assign({ hostname: '', role: role, mac: '', ipv4: '', interface: '', disk_hint: '' }, old[i] || {}, { role: role });
  });
  profile.worker_count = profile.topology === 'standard' ? profile.hosts.filter(function(h) { return h.role === 'worker'; }).length : 0;
}

function okdReadForm() {
  if (!$('#okd-id').length) return okdProfile || okdNewProfile();
  const profile = {
    id: $('#okd-id').val().trim(), release: $('#okd-release').val(), platform: $('#okd-platform').val(),
    topology: $('#okd-topology').val(), cluster_name: $('#okd-cluster-name').val().trim(),
    base_domain: $('#okd-base-domain').val().trim(), machine_network: $('#okd-machine-network').val().trim(),
    rendezvous_ip: $('#okd-rendezvous').val().trim(), ssh_public_key: $('#okd-ssh-key').val().trim(),
    worker_count: Number($('#okd-workers').val()), api_vip: $('#okd-api-vip').val().trim(),
    ingress_vip: $('#okd-ingress-vip').val().trim(), boot_mode: $('input[name="okd-boot-mode"]:checked').val() || 'pxe',
    asset_url: $('#okd-asset-url').val().trim(), asset_certificate_bundle: okdProfile.asset_certificate_bundle || '',
    additional_ca_bundle: okdProfile.additional_ca_bundle || '', hosts: []
  };
  $('#okd-hosts tbody tr').each(function() {
    const row = $(this);
    const diskHintValue = row.find('[data-host="disk_hint_value"]').val().trim();
    profile.hosts.push({
      hostname: row.find('[data-host="hostname"]').val().trim(), role: row.data('role'),
      mac: row.find('[data-host="mac"]').val().trim(), ipv4: row.find('[data-host="ipv4"]').val().trim(),
      interface: row.find('[data-host="interface"]').val().trim(),
      disk_hint: diskHintValue ? row.find('[data-host="disk_hint_type"]').val() + ':' + diskHintValue : ''
    });
  });
  return profile;
}

function okdShowResult(result, forceToast) {
  const box = $('#okd-result');
  const details = (result.errors || []).map(function(e) { return e.field + ': ' + e.message; });
  if (forceToast || okdActiveTab !== 'profiles' || !box.length) {
    showToast([result.message || (result.ok ? 'OKD operation completed.' : 'OKD operation failed.')].concat(details).join(' '), result.ok ? 'success' : 'danger');
    return;
  }
  if (result.ok) { box.removeClass('alert-danger').addClass('alert-success').text(result.message || 'Profile saved and validated.').show(); return; }
  box.removeClass('alert-success').addClass('alert-danger').empty()
    .append($('<strong>').text(result.message || 'OKD operation failed.'))
    .append(details.length ? $('<ul class="mb-0">').append(details.map(function(line) { return $('<li>').text(line); })) : '').show();
}

function okdAfterModalHidden(selector, callback) {
  const modal = $(selector);
  if (!modal.hasClass('show')) { callback(); return; }
  modal.one('hidden.bs.modal', callback).modal('hide');
}

function okdReply(callback) {
  const epoch = okdViewEpoch; const id = okdExistingId; const revision = okdRevision;
  return function(result) {
    if (!okdPageActive || epoch !== okdViewEpoch || id !== okdExistingId || revision !== okdRevision) return;
    callback(result);
  };
}

function okdSubmitPullSecret(secret) {
  okdPullSecretSaving = true; okdPullSecretMessage = 'Saving pull secret…'; okdPullSecretMessageType = 'secondary'; okdUpdatePullSecret();
  const finish = function(err, result) {
    okdPullSecretSaving = false;
    if (err || !result) {
      okdPullSecretMessage = 'Pull-secret submission was not acknowledged. It may have saved; reconnect and check status before submitting again.';
      okdPullSecretMessageType = 'danger';
    } else if (result.ok) { okdPullSecretStatus = result.data; okdPullSecretMessage = 'Pull secret saved to persistent config.'; okdPullSecretMessageType = 'success'; okdRefreshJobs(); }
    else { okdPullSecretMessage = result.message || 'Pull secret could not be saved.'; okdPullSecretMessageType = 'danger'; }
    okdUpdatePullSecret();
  };
  if (!socket.connected) { finish(true); return; }
  // Volatile prevents offline buffering/replay; timeout acks also fail on disconnect.
  socket.volatile.timeout(30000).emit('okd:pull-secret:save', { secret: secret }, finish);
}

function okdSaveProfile(profile) {
  const epoch = okdViewEpoch; const id = okdExistingId; const revision = okdRevision; const submitted = okdSnapshot(profile);
  const current = function() { return okdPageActive && epoch === okdViewEpoch && id === okdExistingId && revision === okdRevision; };
  $('#okd-save').prop('disabled', true).text('Saving…');
  socket.emit('okd:save', { existingId: okdExistingId, expectedRevision: okdRevision, profile: profile }, function(result) {
    if (!current()) return;
    $('#okd-save').prop('disabled', false).text('Save');
    if (!result.ok) { okdShowResult(result); return; }
    const draft = okdReadForm();
    if (draft.ssh_public_key === profile.ssh_public_key) { $('#okd-ssh-key').val(result.data.ssh_public_key); draft.ssh_public_key = result.data.ssh_public_key; }
    okdProfile = okdSnapshot(draft) === submitted ? result.data : Object.assign({}, draft, { id: result.data.id, revision: result.data.revision, saved_at: result.data.saved_at });
    okdExistingId = result.data.id; okdRevision = result.data.revision; okdMarkClean(result.data);
    okdPreflight = { ready: false, errors: [{ message: 'Checking saved profile readiness…' }] };
    okdSavedRelease = result.data.release; okdToolStatus = null; okdGenerationReady = false; okdRefreshTools();
    $('#okd-id').val(result.data.id).prop('disabled', true);
    socket.emit('okd:list', function(listResult) {
      if (!okdPageActive || epoch !== okdViewEpoch || okdExistingId !== result.data.id || okdRevision !== result.data.revision) return;
      if (listResult.ok) okdProfiles = listResult.data;
      okdProfile = Object.assign({}, okdReadForm(), { id: result.data.id, revision: result.data.revision, saved_at: result.data.saved_at });
      okdRefreshJobs(); okdShowResult({ ok: true, message: 'Profile saved. Edits made after submission remain unsaved.' });
    });
  });
}

function okdPrepareProfileSave(profile) {
  const epoch = okdViewEpoch; const submitted = okdSnapshot(profile);
  $('#okd-save').prop('disabled', true).text('Checking…');
  socket.timeout(15000).emit('okd:certificates:validate', { pem: profile.additional_ca_bundle || '' }, function(err, validation) {
    if (!okdPageActive || epoch !== okdViewEpoch || submitted !== okdSnapshot(okdReadForm())) return;
    if (err || !validation || !validation.ok) {
      $('#okd-save').prop('disabled', false).text('Save');
      okdShowResult(validation || { ok: false, message: 'CA validation was not acknowledged.' }); return;
    }
    profile.additional_ca_bundle = validation.data.pem;
    if (profile.boot_mode !== 'pxe') { okdSaveProfile(profile); return; }
    okdInspectCertificate(profile, function(result) {
      if (!result.ok) { $('#okd-save').prop('disabled', false).text('Save'); okdShowResult(result); return; }
      const inspected = result.data; const metadata = inspected.metadata;
      if (metadata.validity !== 'current' || !metadata.hostnameMatch || metadata.storedMismatch) {
        $('#okd-save').prop('disabled', false).text('Save');
        okdShowResult({ ok: false, message: 'Resolve the Asset server certificate validity, name, or stored-certificate mismatch before saving.' }); return;
      }
      if (!metadata.systemTrusted && !metadata.localCertificateMatch && !metadata.additionalCaMatch && !profile.asset_certificate_bundle) {
        if (!inspected.caPem || !confirm('The Asset server certificate is not system trusted. Trust the inspected CA for this profile?')) {
          $('#okd-save').prop('disabled', false).text('Save'); return;
        }
        profile.asset_certificate_bundle = inspected.caPem;
        socket.emit('okd:certificates:confirm', { profileId: profile.id });
      }
      okdProfile.asset_certificate_bundle = profile.asset_certificate_bundle;
      okdSaveProfile(profile);
    });
  });
}

function okdToolCard(name, label) {
  const state = okdToolStatus && okdToolStatus.tools ? okdToolStatus.tools[name] : null;
  const ready = state && state.ready;
  const metadata = ready ? state.metadata : null;
  const busy = state && state.state === 'preparing';
  const required = state ? state.required : true;
  return `<div id="okd-tool-card-${name}" class="col-md-6 mb-2"><div class="border rounded p-3 h-100">
    <div class="d-flex align-items-center"><strong>${label}</strong><span class="badge ${required ? 'badge-danger' : 'badge-secondary'} ml-2">${required ? 'Required' : 'Optional'}</span></div>
    <div class="mt-2" aria-live="polite">${busy ? 'Preparing and verifying on the server…' : (ready ? '<span class="text-success">Ready and verified</span>' : (state && state.state === 'failed' ? '<span class="text-danger">Failed — Save the profile to retry</span>' : '<span class="text-muted">Not ready</span>'))}</div>
    ${metadata ? `<small class="d-block text-break mt-2">Server binary: <code>${okdAttr(state.binaryPath)}</code><br>Verified version: <code>${okdAttr(metadata.release)}</code><br>Source URL: <code>${okdAttr(metadata.sourceUrl)}</code><br>Archive: <code>${okdAttr(metadata.archive)}</code><br>Archive SHA-256: <code>${okdAttr(metadata.archiveSha256)}</code><br>Binary SHA-256: <code>${okdAttr(metadata.binarySha256)}</code><br>Prepared: ${okdAttr(metadata.preparedAt)}</small>` : ''}
    ${state && !ready && state.code ? `<small class="d-block text-danger mt-2">${okdAttr(state.message)}</small>` : ''}
  </div></div>`;
}

function okdUpdateToolsModal() {
  const status = okdToolStatus;
  $('#okd-tools-summary').html(`Saved profile release: <strong>${okdAttr(okdSavedRelease || 'Save a profile first')}</strong> · Architecture: <strong>${okdAttr(status ? status.architecture : 'linux/amd64')}</strong><br>Release image digest: <code>${okdAttr(status ? status.releaseDigest : '')}</code>`);
  $('#okd-tool-card-installer').replaceWith(okdToolCard('installer', 'openshift-install'));
  $('#okd-tool-card-oc').replaceWith(okdToolCard('oc', 'oc'));
  $('#okd-tool-error').toggleClass('d-none', !okdToolError).text(okdToolError);
  $('#okd-tools-progress').toggleClass('d-none', !(status && status.state === 'preparing'));
  $('#okd-tools-ready').toggleClass('text-success', !!(status && status.generationReady)).toggleClass('text-muted', !(status && status.generationReady)).text(`Selected tools: ${status && status.generationReady ? 'required tools ready' : 'required tools not ready'}.`);
  okdUpdateGenerateModal();
  $('#okd-generate-reason').text(okdGenerationReason(okdReadForm()));
}

function okdStopToolPoll() {
  clearTimeout(okdToolPoll); okdToolPoll = null; okdToolEpoch += 1;
}

function okdRefreshTools(attempt = 0) {
  okdStopToolPoll();
  if (!okdPageActive || !okdExistingId || !okdSavedRelease) return;
  const epoch = okdViewEpoch; const token = okdToolEpoch; const id = okdExistingId; const release = okdSavedRelease; const revision = okdRevision;
  socket.timeout(15000).emit('okd:tools:status', release, function(err, result) {
    if (!okdPageActive || epoch !== okdViewEpoch || token !== okdToolEpoch || id !== okdExistingId || release !== okdSavedRelease || revision !== okdRevision) return;
    if (err || !result || !result.ok || result.data.release !== release) {
      okdToolError = 'Unable to load tools status. Reopen Edit to retry.'; okdGenerationReady = false;
      okdUpdateToolsModal(); return;
    }
    const wasReady = okdGenerationReady;
    okdToolError = ''; okdToolStatus = result.data; okdGenerationReady = release === OKD_RELEASE && !!result.data.generationReady;
    okdUpdateToolsModal();
    if (!wasReady && okdGenerationReady && okdGenerateCurrent()) okdCheckGenerate();
    if (result.data.state === 'preparing' && attempt < 300) okdToolPoll = setTimeout(function() { okdRefreshTools(attempt + 1); }, 2000);
    else {
      if (result.data.state === 'preparing') { okdToolError = 'Preparation is still running on the server. Reopen Edit for updated status.'; okdUpdateToolsModal(); }
      if (!wasReady || okdGenerationReady) okdRefreshJobs();
    }
  });
}

function okdUpdatePullSecret() {
  const status = okdPullSecretStatus;
  const state = status ? status.status : 'loading';
  const source = status ? status.source : 'internal';
  const externallyManaged = source === 'external';
  $('#okd-pull-secret-status').text(source === 'default' ? 'Default OKD placeholder — public registries only; no private registry authentication' : `Status: ${state.charAt(0).toUpperCase() + state.slice(1)} · Source: ${source}`)
    .toggleClass('text-success', state === 'ready').toggleClass('text-danger', state === 'invalid').toggleClass('text-muted', !['ready', 'invalid'].includes(state));
  $('#okd-pull-secret-input').prop('disabled', okdPullSecretSaving || externallyManaged);
  $('#okd-pull-secret-disabled').text(status ? (status.disabledReasons || []).join(' ') : 'Loading management permissions…');
  $('#okd-pull-secret-auth-warning').toggleClass('d-none', !status || status.authenticationConfigured !== false);
  $('#okd-pull-secret-save').prop('disabled', okdPullSecretSaving || externallyManaged || !(status && status.writable))
    .attr('aria-busy', okdPullSecretSaving ? 'true' : 'false')
    .text(okdPullSecretSaving ? 'Saving…' : (status && status.exists ? 'Update pull secret' : 'Add pull secret'));
  $('#okd-pull-secret-loading').toggleClass('d-none', !okdPullSecretSaving);
  $('#okd-pull-secret-message').removeClass('d-none alert-success alert-danger alert-secondary').addClass(`alert-${okdPullSecretMessageType}`).text(okdPullSecretMessage).toggleClass('d-none', !okdPullSecretMessage);
}

function okdLoadPullSecretStatus() {
  okdPullSecretMessage = 'Loading pull-secret status…'; okdPullSecretMessageType = 'secondary'; okdUpdatePullSecret();
  socket.emit('okd:pull-secret:status', {}, function(result) {
    if (result.ok) { okdPullSecretStatus = result.data; okdPullSecretMessage = ''; }
    else { okdPullSecretMessage = result.message || 'Unable to load pull-secret status.'; okdPullSecretMessageType = 'danger'; }
    okdUpdatePullSecret();
  });
}

function okdRefreshView() {
  if (!okdPageActive) return;
  if (okdJobPoll) clearTimeout(okdJobPoll);
  if (okdJobStatus.current || okdJobStatus.blocking) okdJobPoll = setTimeout(okdRefreshJobs, 1500);
  okdUpdateToolsModal();
  // Keep typed fields and modal DOM intact; render latest state only when safe.
  if (okdModalOpen || $('[id^="okd-"][id$="-modal"]').hasClass('show')) return;
  if (okdActiveTab === 'profiles' && $('#okd-id').length) {
    return;
  }
  okdRenderForm();
}

function okdRefreshJobs() {
  if (!okdPageActive) return;
  if (!okdExistingId) { okdJobStatus = { current: null, blocking: null, history: [] }; okdVersions = []; okdPreflight = { ready: false, errors: [{ message: 'Select and save a profile.' }] }; okdRenderForm(); return; }
  const requestProfile = okdExistingId; const requestRevision = okdRevision;
  const requestEpoch = okdViewEpoch;
  const stale = function() { return !okdPageActive || requestEpoch !== okdViewEpoch || requestProfile !== okdExistingId || requestRevision !== okdRevision; };
  socket.emit('okd:jobs:status', requestProfile, function(statusResult) {
    if (stale()) return;
    if (statusResult.ok) okdJobStatus = statusResult.data;
    socket.emit('okd:versions:list', requestProfile, function(versionResult) {
      if (stale()) return;
      okdVersions = versionResult.ok ? versionResult.data : [];
      if (!versionResult.ok) okdShowResult(versionResult);
      okdRefreshView();
    });
    if (okdSnapshot(okdReadForm()) !== okdBaseline) return;
    socket.emit('okd:jobs:preflight', { profileId: requestProfile, revision: requestRevision }, function(checkResult) {
      if (stale()) return;
      okdPreflight = checkResult.ok ? checkResult.data : { ready: false, errors: [{ message: checkResult.message }] };
      okdRefreshView();
    });
  });
}

function okdVersionCard() {
  const active = okdVersions.find(function(version) { return version.active; });
  if (!okdExistingId) return '';
  const rows = okdVersions.map(function(version) {
    const mediaVersion = version.mediaVersion || version.versionId;
    const files = (version.files || []).map(function(file) {
      return `${okdAttr(file.role)}: ${okdAttr(file.name)} · ${okdAttr(file.size)} bytes · <code>${okdAttr(file.sha256)}</code>`;
    }).join('<br>');
    const publish = version.mode === 'pxe' && !version.active
      ? `<button class="btn btn-outline-primary btn-sm" data-okd-publish="${okdAttr(mediaVersion)}" data-release="${okdAttr(version.release)}">${active ? 'Activate' : 'Publish'}</button>` : '';
    const unpublish = version.active ? '<button class="btn btn-outline-warning btn-sm" data-okd-unpublish>Unpublish</button>' : '';
    const remove = !version.active ? `<button class="btn btn-outline-danger btn-sm" data-okd-delete-version="${okdAttr(mediaVersion)}" data-release="${okdAttr(version.release)}">Delete</button>` : '';
    const iso = version.mode === 'iso' ? `<a href="<%= baseurl %>okd/${encodeURIComponent(version.profileId)}/${encodeURIComponent(version.release)}/${encodeURIComponent(mediaVersion)}/iso">Download ISO</a>` : '';
    return `<tr><td><code>${okdAttr(mediaVersion)}</code>${version.active ? ' <span class="badge badge-success">Active</span>' : ''}</td>
      <td>${okdAttr(version.mode)}</td><td>${okdAttr(version.createdAt)}</td><td class="small text-break">${files}<br>Profile revision: <code>${okdAttr(version.profileRevision)}</code>${version.baseUrl ? `<br><code>bootArtifactsBaseURL: ${okdAttr(version.baseUrl.replace(/\/$/, ''))}</code>` : ''} ${iso}</td>
      <td>${publish} ${unpublish} ${remove}</td></tr>`;
  }).join('');
  return `<div id="okd-versions" class="border rounded p-2 mb-3"><strong>Artifacts</strong>
    ${rows ? `<div class="table-responsive mt-2"><table class="table table-sm table-bordered mb-0"><thead><tr><th>Version</th><th>Mode</th><th>Created</th><th>Checksums / provenance</th><th>Actions</th></tr></thead><tbody>${rows}</tbody></table></div>` : '<div class="small text-muted mt-2">No finalized versions.</div>'}
    <small class="d-block text-muted mt-2">Activating a previous PXE version changes only the boot-menu target; it does not roll back machines or clusters.</small></div>`;
}

function okdGenerationReason(profile) {
  if (!okdExistingId) return 'Profile not saved';
  if (okdSnapshot(profile) !== okdBaseline) return 'Unsaved changes';
  if (okdJobStatus.current || okdJobStatus.blocking) return 'Generation in progress';
  if (okdToolStatus && okdToolStatus.state === 'preparing') return 'Tools preparing';
  if (okdToolError || (okdToolStatus && okdToolStatus.state === 'failed')) return 'Tool preparation failed';
  if (!(okdPreflight.ready || (okdPreflight.perMode && okdPreflight.perMode.iso.ready))) return 'Not ready';
  return okdGenerationReady ? '' : 'Tools not ready';
}

function okdGenerateCurrent() {
  const c = okdGenerateContext;
  return c && okdPageActive && c.epoch === okdViewEpoch && c.id === okdExistingId && c.revision === okdRevision && c.modal === $('#okd-generate-modal')[0];
}

function okdGenerateProblems() {
  const c = okdGenerateContext; const errors = []; const warnings = [];
  if (!okdExistingId) warnings.push('Save the new profile before generation.');
  else if (okdSnapshot(okdReadForm()) !== okdBaseline) warnings.push('Save or discard unsaved form changes before generation.');
  if (okdJobStatus.current || okdJobStatus.blocking) warnings.push('Generation is already active on this instance.');
  if (!okdGenerationReady) {
    if (okdToolStatus && okdToolStatus.state === 'preparing' && (!okdToolError || okdToolError.includes('still running'))) warnings.push('Required tools are preparing. Wait for verification.');
    else if (okdToolError || (okdToolStatus && okdToolStatus.state === 'failed')) errors.push('Required tools are unavailable. Check Edit → Tools and retry preparation.');
    else warnings.push(okdToolStatus && okdToolStatus.state === 'preparing' ? 'Required tools are preparing. Wait for verification.' : 'Required tools are not ready yet. Check Edit → Tools.');
  }
  if (!okdGenerateCurrent()) warnings.push('Profile context changed. Close and reopen Generate to check again.');
  else {
    const check = c.check;
    for (const problem of (check.errors || [])) {
      if (['revision', 'job'].includes(problem.field)) warnings.push(problem.message);
      else if (['installer', 'oc'].includes(problem.field) && okdToolStatus && okdToolStatus.state === 'preparing') warnings.push('Required tools are preparing. Wait for verification.');
       else errors.push(problem.message);
    }
    if (c.failure) errors.push(c.failure);
    if (!c.checking && !check.ready && !errors.length && !warnings.length) warnings.push('Prerequisites are not ready. Close and reopen Generate to retry.');
  }
  return { errors: [...new Set(errors)], warnings: [...new Set(warnings)] };
}

function okdUpdateGenerateModal() {
  const list = function(title, items, kind) { return items.length ? `<div class="alert alert-${kind}"><strong>${title}</strong><ul class="mb-0">${items.map(function(message) { return `<li>${okdAttr(message)}</li>`; }).join('')}</ul></div>` : ''; };
  const problems = okdGenerateProblems(); const mode = (okdProfile && okdProfile.boot_mode || 'pxe').toUpperCase(); const c = okdGenerateContext;
  $('#okd-generate-problems').html(list(`${mode} errors`, problems.errors, 'danger') + list(`${mode} — resolve before generation`, problems.warnings, 'warning'));
  $('#okd-generate-action').text(!c ? '' : c.starting ? 'Starting generation…' : c.checking ? 'Checking current prerequisites…' : (!problems.errors.length && !problems.warnings.length ? 'Checks passed — starting generation…' : ''));
}

function okdCheckGenerate() {
  const c = okdGenerateContext;
  if (!okdGenerateCurrent() || c.starting) return;
  c.check = { ready: false }; c.failure = ''; c.checking = false;
  if (!c.id || okdSnapshot(okdReadForm()) !== okdBaseline) { okdUpdateGenerateModal(); return; }
  c.checking = true; const token = ++okdGenerateEpoch; let remaining = 2;
  okdUpdateGenerateModal();
  const reply = function(apply) { return function(err, result) {
    if (!okdGenerateCurrent() || c !== okdGenerateContext || token !== okdGenerateEpoch) return;
    if (err || !result) c.failure = 'Prerequisite check was not acknowledged within 15 seconds. Check your connection and reopen Generate to retry.';
    else if (!result.ok) c.failure = result.message || 'Unable to check prerequisites.';
    else apply(result.data);
    remaining -= 1; c.checking = remaining > 0; okdUpdateGenerateModal();
    if (!c.checking) { const problems = okdGenerateProblems(); if (!problems.errors.length && !problems.warnings.length) okdStartGenerate(); }
  }; };
  socket.timeout(15000).emit('okd:jobs:preflight', { profileId: c.id, revision: c.revision }, reply(function(data) {
    c.check = data.profileRevision === c.revision ? data : { ready: false, errors: (data.errors || []).concat([{ field: 'revision', message: 'Saved revision changed. Reload the profile before generation.' }]) };
  }));
  socket.timeout(15000).emit('okd:jobs:status', c.id, reply(function(data) { okdJobStatus = data; }));
}

function okdStartGenerate() {
  const c = okdGenerateContext;
  if (!c || c.starting || c.checking || !okdGenerateCurrent()) return;
  const problems = okdGenerateProblems();
  if (problems.errors.length || problems.warnings.length) { okdUpdateGenerateModal(); return; }
  c.starting = true; okdUpdateGenerateModal();
  socket.volatile.timeout(15000).emit('okd:jobs:start', { profileId: okdExistingId, revision: okdRevision, confirmed: true }, function(err, result) {
    if (!okdGenerateCurrent() || c !== okdGenerateContext) return;
    c.starting = false;
    if (err || !result || !result.ok) {
      c.check = { ready: false, errors: result && result.errors || [] };
      c.failure = err || !result ? 'Generation request was not acknowledged. It may have started; close and reopen Generate to check status before retrying.' : result.message || 'Generation failed.';
      if (result && ['OPERATION_ACTIVE', 'JOB_ACTIVE', 'MONITOR_ACTIVE', 'STALE_REVISION'].includes(result.code)) {
        c.check.errors = c.check.errors.concat([{ field: result.code === 'STALE_REVISION' ? 'revision' : 'job', message: c.failure }]); c.failure = '';
      }
      okdUpdateGenerateModal(); return;
    }
    okdJobLog = '';
    okdAfterModalHidden('#okd-generate-modal', okdRefreshJobs);
  });
}

function okdPullSecretBox() {
  return `<section class="border rounded p-3 mt-3" aria-labelledby="okd-pull-secret-title"><div class="d-flex align-items-center mb-2"><h6 id="okd-pull-secret-title" class="mb-0">Shared pull secret</h6><button type="button" class="btn btn-outline-secondary btn-sm rounded-circle p-0 ml-1 d-inline-flex align-items-center justify-content-center" style="width:1.25rem;height:1.25rem" aria-label="Shared pull secret help" aria-describedby="okd-pull-secret-overview-help" title="Default OKD placeholder — public registries only; no private registry authentication&#10;&#10;The active pull secret is inserted into the generated install-config.yaml. Saving it here persists and reuses it, so you do not need to paste it into every profile or config. Existing credentials are never retrieved or displayed. The persisted secret and generated config are plaintext files protected by filesystem permissions; WEBAPP authentication controls access but does not encrypt them. Mounted external credentials are authoritative and read-only."><i class="bi bi-question-lg" aria-hidden="true"></i></button></div>
    <span id="okd-pull-secret-overview-help" class="sr-only">Default OKD placeholder — public registries only; no private registry authentication. The active pull secret is inserted into the generated install-config.yaml. Saving it here persists and reuses it, so you do not need to paste it into every profile or config. Existing credentials are never retrieved or displayed. The persisted secret and generated config are plaintext files protected by filesystem permissions; WEBAPP authentication controls access but does not encrypt them. Mounted external credentials are authoritative and read-only.</span>
    <div id="okd-pull-secret-status" class="small text-muted mb-2" aria-live="polite">Loading status…</div>
    <div id="okd-pull-secret-auth-warning" class="alert alert-warning py-2 d-none" role="alert"><strong>Warning:</strong> WEBAPP_USER/WEBAPP_PASS are not configured. Pull secret management is unauthenticated, and the pull secret is stored unencrypted (plaintext) in persistent config; filesystem permissions still apply.</div>
    <div id="okd-pull-secret-disabled" class="small text-warning mb-2"></div>
    <div class="d-flex align-items-center mb-2"><label for="okd-pull-secret-input" class="mb-0">Add/update pull secret JSON</label><button type="button" class="btn btn-outline-secondary btn-sm rounded-circle p-0 ml-1 d-inline-flex align-items-center justify-content-center" style="width:1.25rem;height:1.25rem" aria-label="Pull secret input help" aria-describedby="okd-pull-secret-help" title="Enter JSON directly without outer shell quotes, for example {&quot;auths&quot;:{&quot;fake&quot;:{&quot;auth&quot;:&quot;aWQ6cGFzcwo=&quot;}}}. Up to 1 MiB. Input is cleared on submission or closing this popup. Never paste credentials into profile YAML."><i class="bi bi-question-lg" aria-hidden="true"></i></button></div>
    <span id="okd-pull-secret-help" class="sr-only">Enter JSON directly without outer shell quotes, for example {"auths":{"fake":{"auth":"aWQ6cGFzcwo="}}}. Up to 1 MiB. Input is cleared on submission or closing this popup. Never paste credentials into profile YAML.</span><textarea id="okd-pull-secret-input" class="form-control text-monospace" rows="5" maxlength="1048576" autocomplete="new-password" spellcheck="false" aria-describedby="okd-pull-secret-help"></textarea>
    <div id="okd-pull-secret-message" class="alert alert-secondary py-2 mt-2 d-none" aria-live="polite"></div>
    <div id="okd-pull-secret-loading" class="spinner-border spinner-border-sm mr-2 d-none" role="status" aria-label="Saving pull secret"></div><button id="okd-pull-secret-save" class="btn btn-primary btn-sm mt-2" disabled aria-busy="false">Add pull secret</button>
  </section>`;
}

function okdDuration(record, active) {
  const start = Date.parse(record.startedAt || record.createdAt); const end = Date.parse(record.finishedAt || (active ? new Date().toISOString() : ''));
  if (!Number.isFinite(start) || !Number.isFinite(end) || end < start) return '—';
  const seconds = Math.floor((end - start) / 1000); return `${Math.floor(seconds / 60)}m ${seconds % 60}s`;
}

function okdJobCard(profile) {
  const current = okdJobStatus.current;
  const blocking = okdJobStatus.blocking;
  const mode = (profile.boot_mode || 'pxe').toUpperCase();
  const destination = profile.boot_mode === 'pxe' ? `${profile.asset_url || ''}okd/${profile.id}/${profile.release}/&lt;next-version&gt;/` : 'Authenticated ISO download';
  return `<section id="okd-generation-status" class="border border-primary rounded p-3 mb-3">
    <h5>Generate installation media</h5><dl class="row small mb-2"><dt class="col-sm-3">Profile</dt><dd class="col-sm-9">${okdAttr(profile.id)}</dd><dt class="col-sm-3">Mode</dt><dd class="col-sm-9">${okdAttr(mode)}</dd><dt class="col-sm-3">Release</dt><dd class="col-sm-9">${okdAttr(profile.release)}</dd><dt class="col-sm-3">Destination</dt><dd class="col-sm-9 text-break"><code>${destination}</code></dd><dt class="col-sm-3">Readiness</dt><dd id="okd-generate-reason" class="col-sm-9" aria-live="polite">${okdAttr(okdGenerationReason(profile) || 'Ready')}</dd></dl>
    <button id="okd-generate" class="btn btn-danger btn-sm">Generate ${okdAttr(mode)}</button>
    ${(current || blocking) ? `<hr><h6>Active generation</h6><div id="okd-job-state" aria-live="polite"><strong>${okdAttr((current || blocking).state)}</strong> · ${okdAttr((current || blocking).mediaVersion || 'allocating version')} · ${okdAttr((current || blocking).message || '')}</div><small class="d-block text-muted mb-2">Created: ${okdAttr((current || blocking).createdAt || '—')} · Started: ${okdAttr((current || blocking).startedAt || '—')} · Elapsed: ${okdAttr(okdDuration(current || blocking, true))}</small>` : '<div id="okd-job-state" class="sr-only" aria-live="polite">No active generation.</div>'}
    ${current && current.cancellable ? '<button id="okd-cancel" class="btn btn-outline-danger btn-sm ml-2">Cancel</button>' : ''}
    ${current ? '<button id="okd-log" class="btn btn-outline-secondary btn-sm ml-2">Show/hide log</button>' : ''}
    ${okdJobLog ? `<pre class="border rounded p-2 mt-2 mb-0" style="max-height:18rem;overflow:auto">${okdAttr(okdJobLog)}</pre>` : ''}
  </section>`;
}

function okdOperationsCard() {
  if (!okdExistingId) return '';
  const versions = new Map(okdVersions.map(function(version) { return [`${version.release}/${version.mediaVersion || version.versionId}`, version]; }));
  const rows = (okdJobStatus.history || []).map(function(job) {
    const mediaVersion = job.mediaVersion || job.versionId; const release = job.release || okdProfile.release; const version = versions.get(`${release}/${mediaVersion}`); const successful = job.state === 'succeeded';
    const download = successful && job.mode === 'pxe' ? `<a class="btn btn-link btn-sm" href="<%= baseurl %>okd/${encodeURIComponent(job.profileId)}/${encodeURIComponent(release)}/${encodeURIComponent(mediaVersion)}/pxe.tar.gz">Download PXE bundle</a>` : successful && job.mode === 'iso' ? `<a class="btn btn-link btn-sm" href="<%= baseurl %>okd/${encodeURIComponent(job.profileId)}/${encodeURIComponent(release)}/${encodeURIComponent(mediaVersion)}/iso">Download ISO</a>` : '';
    return `<tr><td><code>${okdAttr(mediaVersion)}</code></td><td>${okdAttr((job.mode || '').toUpperCase())}</td><td>${okdAttr(job.state)}</td><td>${okdAttr(job.createdAt || '—')}</td><td>${okdAttr(okdDuration(job, false))}</td><td><button class="btn btn-link btn-sm" data-okd-history-log="${okdAttr(mediaVersion)}" data-release="${okdAttr(release)}">Log</button>${download}${version ? '<button class="btn btn-link btn-sm" data-okd-view-artifacts>View artifacts</button>' : ''}</td></tr>`;
  }).join('');
  return `<section id="okd-recent-generations" class="border rounded p-3 mb-3"><h5>Recent generations</h5>${rows ? `<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Version</th><th>Mode</th><th>State</th><th>Created</th><th>Duration</th><th>Actions</th></tr></thead><tbody>${rows}</tbody></table></div>` : '<p class="small text-muted mb-0">No recent generations.</p>'}</section>`;
}

function okdRenderForm() {
  if (!okdPageActive) return;
  if (okdModalOpen || $('[id^="okd-"][id$="-modal"]').hasClass('show')) return;
  $('#pagecontent details[id]').each(function() { okdDetailsOpen[this.id] = this.open; });
