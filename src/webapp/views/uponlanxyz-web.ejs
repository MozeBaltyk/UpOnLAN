      <li class="nav-item"><button class="nav-link ${artifactsTab ? 'active' : ''}" data-okd-tab="artifacts" type="button" role="tab" aria-selected="${artifactsTab ? 'true' : 'false'}">Artifacts</button></li>
    </ul>
