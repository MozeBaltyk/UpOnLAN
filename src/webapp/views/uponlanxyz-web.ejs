// Highlight active nav item and switch pages
function navTo(page, navId) {
  okdViewEpoch += 1;
  okdStopToolPoll();
  if (page !== 'renderokd') {
    okdPageActive = false;
    if (okdJobPoll) clearTimeout(okdJobPoll);
    $('#okd-pull-secret-input').val('');
    const modal = $('[id^="okd-"][id$="-modal"]').filter(':visible');
    if (modal.length) {
      // Let Bootstrap remove its backdrop/body state before the page removes the modal.
      const epoch = okdViewEpoch;
      modal.one('hidden.bs.modal', function() { if (epoch === okdViewEpoch) navTo(page, navId); });
      modal.one('shown.bs.modal', function() { $(this).modal('hide'); }).modal('hide');
      return;
    }
    $('[id^="okd-"][id$="-modal"]').modal('hide');
    okdModalOpen = false;
  }
  setActiveNav(navId);
  vmDisposeVnc(); // leaving a page may abandon the console: free QEMU's single VNC client
  window[page]();
}

//// Theme Management ////
function initializeTheme() {
  const savedTheme = localStorage.getItem('saved-theme') || 'light';
  const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  const theme = savedTheme || (prefersDark ? 'dark' : 'light');
  applyTheme(theme);
}

function toggleTheme() {
  const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
  const newTheme = currentTheme === 'light' ? 'dark' : 'light';
  applyTheme(newTheme);
  localStorage.setItem('saved-theme', newTheme);
}

function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  const themeIcon = document.getElementById('theme-icon');
  if (themeIcon) {
    themeIcon.textContent = theme === 'light' ? '🌙' : '☀️';
  }
  
  // Update Ace Editor theme if it exists
  updateAceEditorTheme(theme);

  // Re-color the metrics chart legend (its label color is set at init; refresh
  // it on theme toggle so it stays visible against a dark background).
  if (typeof MetricsChart !== 'undefined' && MetricsChart && MetricsChart.options
      && MetricsChart.options.plugins && MetricsChart.options.plugins.legend) {
    MetricsChart.options.plugins.legend.labels.color = chartLegendColor(theme);
    MetricsChart.update();
  }
}

// Readable Chart.js legend label color for the active theme.
function chartLegendColor(theme) {
  const t = theme || document.documentElement.getAttribute('data-theme');
  return t === 'dark' ? '#cccccc' : '#444';
}

function updateAceEditorTheme(theme) {
  const editorElement = document.getElementById('editor');
  if (editorElement && typeof ace !== 'undefined') {
    try {
      const editor = ace.edit('editor');
      const aceTheme = theme === 'dark' ? 'ace/theme/monokai' : 'ace/theme/chrome';
      editor.setTheme(aceTheme);
    } catch (e) {
      // Editor might not be initialized yet, ignore
    }
  }
}

