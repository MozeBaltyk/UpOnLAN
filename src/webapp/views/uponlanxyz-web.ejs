// Version control for the provisioning editor. Kickstart profiles get a distro
// dropdown (the value feeds `ksvalidator -v <token>`); cloud-init keeps free text
// (metadata only — `cloud-init schema` takes no version flag).
function provisioningVersionControl(filename, version) {
  if (String(filename).split('/').pop() === 'ks.cfg') {
    const options = [
      ['', 'Select distro…'],
      ['RHEL7', 'RHEL 7'],
      ['RHEL8', 'RHEL 8'],
      ['RHEL9', 'RHEL 9'],
      ['F40', 'Fedora 40'],
      ['F41', 'Fedora 41'],
    ];
    const current = version || '';
    // Preserve a stored value that isn't in the list (e.g. an older free-text entry).
    if (current && !options.some(([v]) => v === current)) {
      options.splice(1, 0, [current, current + ' (custom)']);
    }
    const opts = options.map(([v, label]) =>
      `<option value="${v}"${v === current ? ' selected' : ''}>${label}</option>`
    ).join('');
    return `<select id="provisioning-version" class="form-control form-control-sm">${opts}</select>`;
  }
  return `<input type="text" id="provisioning-version" class="form-control form-control-sm" placeholder="e.g. 24.04" value="${version || ''}">`;
}

