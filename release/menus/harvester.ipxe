#!ipxe

# Harvester
# https://harvesterhci.io/
# https://docs.harvesterhci.io/v1.0/install/pxe-boot-install/

goto ${menu} ||

:harvester
set os Harvester
menu ${os} - ${arch}
item --gap Harvester:
item harvester_url ${space} Begin install of Harvester ${os} v1.7.3 (${arch})
item --gap Parameters:
item harvester_config_url ${space} Set config-create or config-join.yaml URL: ${harvester_config_url}
choose --default ${menu} menu || goto harvester_exit
echo ${cls}
goto ${menu} ||
goto harvester_exit

:harvester_config_url
echo -n Set config.yaml URL:  && read harvester_config_url
clear menu
goto harvester

:harvester_url
# ponytail: version pinned to the mirrored bundle (harvester-v1.7.3-<arch> in
# endpoints.yml); re-bump when release_assets mirrors a newer Harvester.
set harvester_url ${mirror_endpoint}${asset_path}harvester-v1.7.3-${arch}/
goto harvester_boot

:harvester_boot
set install_params harvester.install.automatic=true harvester.install.config_url=${harvester_config_url}
set boot_params ip=dhcp net.ifnames=1 console=ttyS0 console=tty1 rd.cos.disable root=live:${harvester_url}squashfs.img rd.noverifyssl
imgfree
kernel ${harvester_url}vmlinuz ${install_params} ${boot_params} initrd=initrd.magic ${cmdline}
initrd ${harvester_url}initrd
echo
echo MD5sums:
md5sum vmlinuz initrd
boot

:harvester_exit
clear menu
exit 0
