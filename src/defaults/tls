# HTTPS listeners — written by init.sh only when /config/tls/server.crt +
# /config/tls/server.key are mounted. The plain-HTTP listeners in `default`
# stay active so iPXE boot clients (which speak plain HTTP on the trusted LAN)
# keep working. This file mirrors the HTTP `default` site for asset serving
# and reverse-proxies the webapp (socket.io included) over TLS.

# Asset serving over TLS — same roots as the HTTP listener.
server {
	listen ${HTTPS_PORT} ssl;
	ssl_certificate /config/tls/server.crt;
	ssl_certificate_key /config/tls/server.key;

	location / {
		root /assets;
		autoindex on;
	}

	rewrite ^/rom$ /rom/ permanent;

	location /rom {
		root /config/menus;
		index index.html;
		autoindex on;
	}

	location /status {
		stub_status;
		allow 127.0.0.1;
		deny all;
		access_log off;
	}
}

# Webapp over TLS — reverse proxy to the Node app (HTTP on loopback), with the
# WebSocket upgrade headers socket.io needs.
server {
	listen ${WEBAPP_HTTPS_PORT} ssl;
	ssl_certificate /config/tls/server.crt;
	ssl_certificate_key /config/tls/server.key;

	location / {
		proxy_pass http://127.0.0.1:${WEB_APP_PORT};
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}
}
