// --- Alert Helper ---
function showAlert(type, message) {
  $('#buildAlertArea').html(`
    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
      ${message}
      <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  `);
  setTimeout(() => $('#buildAlertArea .alert').alert('close'), 8000);
  document.querySelector(`#buildAlertArea .alert-${type}`)?.scrollIntoView({ behavior: 'smooth' });
}

// --- Form Handler ---
$(document).on('submit', '#buildForm', function (e) {
  e.preventDefault();

  const formats = [];
  if ($('#optionLegacy').is(':checked')) formats.push('legacy');
  if ($('#optionEFI').is(':checked')) formats.push('efi');
  if ($('#optionISO').is(':checked')) formats.push('iso');
  if ($('#optionUSB').is(':checked')) formats.push('usb');

  if (formats.length === 0) {
    showAlert('danger', 'Select at least one format to build.');
    return;
  }

  // Submit the build
  $('#buildForm button[type="submit"]').prop('disabled', true);
  $('#buildFormBody').hide();
  $('#buildProgressContainer').removeClass('d-none');
  $('#buildProgressBar').removeClass('bg-danger').addClass('bg-success').css('width', '0%').text('0%');
  $('#buildTaskLabel').text('Initializing...');
  socket.emit('buildsubmit', { formats: formats.join(',') });
});

// Progress updates
socket.on('buildProgress', function (progress) {
  const percent = progress.taskCount > 0 
    ? Math.round((progress.tasksCompleted / progress.taskCount) * 100)
    : 0;

  $('#buildProgressBar').css('width', percent + '%').text(`${percent}%`);
  if (progress.currentTask) $('#buildTaskLabel').text(progress.currentTask);
});

socket.on('buildMenuResult', function (result) {
  $('#buildForm button[type="submit"]').prop('disabled', false);
  $('#buildProgressBar').css('width', '100%');

  if (result.message === 'No active playbook running') {
    showAlert('info', 'There is no build in progress to cancel.');
    $('#buildTaskLabel').text('No build running.');
    $('#buildProgressBar')
      .removeClass('bg-success bg-danger bg-warning')
      .addClass('bg-info')
      .css('width', '100%')
      .text('Idle');
    setTimeout(() => {
      $('#buildModal').modal('hide');
      resetBuildModal();
    }, 5000);
    return;
  }

  let alertType, labelText;

  if (result.status === 'cancelled') {
    alertType = 'warning';
    labelText = 'Cancelled';
  } else if (result.status === 'error' || result.success === false) {
    alertType = 'danger';
    labelText = 'Build failed. See logs for details.';
  } else {
    alertType = 'success';
    labelText = 'Build completed successfully.';
  }

  showAlert(alertType, result.message);
  $('#buildProgressBar')
    .removeClass('bg-success bg-danger bg-warning')
    .addClass(alertType === 'danger' ? 'bg-danger' :
              alertType === 'warning' ? 'bg-warning' : 'bg-success')
    .css('width', '100%')
    .text(labelText === 'Cancelled' ? 'Cancelled' : (alertType === 'danger' ? 'Failed' : '100%'));

  $('#buildTaskLabel').text(labelText);

  // Hide modal after delay
  setTimeout(() => {
    $('#buildModal').modal('hide');
     resetBuildModal();
  }, 8000);
});

// Reset modal form
function resetBuildModal() {
  $('#buildForm button[type="submit"]').prop('disabled', false);
  $('#buildFormBody').show();
  $('#buildProgressContainer').addClass('d-none');
  $('#buildProgressBar')
    .removeClass('bg-success bg-danger bg-warning')
    .css('width', '0%')
    .text('0%');
  $('#buildTaskLabel').text('');
  $('#buildAlertArea').html('');
}

