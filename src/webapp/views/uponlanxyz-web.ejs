// Toast notifications (Bootstrap 4 toast, auto-dismissing)
function showToast(message, type) {
  type = type || 'info';
  const icons = { success: '✅', danger: '❌', warning: '⚠️', info: 'ℹ️' };
  // Record the popup in the webapp log (renderweblog) so it's not lost once
  // the toast fades.
  if (typeof socket !== 'undefined' && socket) {
    socket.emit('logmessage', `[${type}] ${message}`);
  }
  const el = document.createElement('div');
  el.className = 'toast show';
  el.setAttribute('role', 'alert');
  el.setAttribute('aria-live', 'assertive');
  el.setAttribute('aria-atomic', 'true');
  el.setAttribute('data-autohide', 'true');
  el.innerHTML =
    '<div class="toast-header">' +
      '<strong class="mr-auto text-uppercase small">' + type + '</strong>' +
      '<button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close"><span aria-hidden="true">&times;</span></button>' +
    '</div>' +
    '<div class="toast-body">' + icons[type] + ' ' + message + '</div>';
  const container = document.getElementById('toast-container');
  if (container) {
    container.appendChild(el);
    // The toast is built by hand (Bootstrap's toast plugin is never .toast()'d),
    // so data-dismiss="toast" does nothing. Wire the × to the same fade-out as
    // the auto-dismiss timer so it closes immediately instead of waiting 10s.
    const closeBtn = el.querySelector('.close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        el.classList.remove('show');
        setTimeout(function () { el.remove(); }, 350);
      });
    }
    setTimeout(function() { el.classList.remove('show'); setTimeout(function() { el.remove(); }, 350); }, 10000);
  }
  // Fallback if container is missing (page not fully rendered yet)
  else {
    alert(message);
  }
}

// Consistent loading state injected into a container
function showLoading(selector, message) {
  $(selector).empty().append(
    '<center class="py-5"><div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">' +
    '<span class="sr-only">Loading...</span></div><br><h5 class="mt-3 text-muted">' + message + '</h5></center>'
  );
}

