#!/bin/sh
# sudo wrapper around /usr/bin/virsh — the security gate in front of the host
# libvirt socket. Only the subcommands the webapp needs are allowed, and any
# domain/network/pool/volume name is charset-validated so no user-controlled
# value reaches virsh unvalidated. Replaces the old per-subcommand sudoers list.
#
# Used by src/webapp/sockets/vmHandlers.js via `sudo /usr/local/bin/virsh-safe`.

fail() { exit 1; }

# a "name" (domain/network/pool/volume) must be a safe identifier
is_name() {
  case "$1" in ''|*[!a-zA-Z0-9_.-]*) return 1 ;; *) return 0 ;; esac
}

cmd="${1:-}"; shift

case "$cmd" in
  start|destroy|domstate|dumpxml)
    is_name "${1:-}" || fail
    ;;
  undefine)
    [ "${1:-}" = "--nvram" ] || fail
    is_name "${2:-}" || fail
    ;;
  console)
    [ "${1:-}" = "--force" ] || fail
    is_name "${2:-}" || fail
    ;;
  define|net-define)
    case "${1:-}" in /tmp/uponlan-*.xml|/tmp/uponlan-net-*.xml) ;; *) fail ;; esac
    ;;
  net-start|net-autostart|net-destroy|net-undefine|net-info)
    is_name "${1:-}" || fail
    ;;
  pool-info|pool-start|pool-autostart|pool-destroy|pool-undefine)
    is_name "${1:-}" || fail
    ;;
  pool-define-as)
    is_name "${1:-}" || fail
    [ "${2:-}" = "dir" ] || fail
    [ "${3:-}" = "--target" ] || fail
    [ -n "${4:-}" ] || fail
    ;;
  vol-create-as)
    is_name "${1:-}" || fail
    is_name "${2:-}" || fail
    [ "${3:-}" = "--format" ] || fail
    [ "${4:-}" = "qcow2" ] || fail
    [ -n "${5:-}" ] || fail
    ;;
  vol-path|vol-delete)
    [ "${1:-}" = "--pool" ] || fail
    is_name "${2:-}" || fail
    is_name "${3:-}" || fail
    ;;
  *)
    fail
    ;;
esac

exec /usr/bin/virsh "$cmd" "$@"