    </div>
    <div class="col-auto">
      <button data-provisioning-version="${encodedFilename}" class="btn btn-outline-secondary btn-sm">Save Version</button>
    </div>
    <div class="col-auto">
      <button data-provisioning-validate="${encodedFilename}" class="btn btn-outline-primary btn-sm">Validate</button>
    </div>
  </div>`;
  renderEditorFile(filename, response, buttons, toolbar);
});

