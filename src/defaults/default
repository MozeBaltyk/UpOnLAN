# Single HTTPS site — written by init.sh. UpOnLAN.xyz serves assets and the webapp
# over TLS only; there is no plain-HTTP listener. iPXE boot clients fetch
# kernel/initrd over HTTPS via ${local_endpoint} (https://<host>:8443/), so the
# ROMs must embed this deployment's cert/CA as trust (see TRUST= in
# scripts/build_ipxe_roms.sh).

# Asset serving over TLS.
server {
	listen ${HTTPS_PORT} ssl;
	ssl_certificate /config/tls/server.crt;
	ssl_certificate_key /config/tls/server.key;

	location = /okd { return 301 /okd/; }
	# Only the fixed PXE outputs are public. ISO and manifest/private names fall
	# through to the deny location and are downloadable only through the portal.
	# Accepts legacy "/okd/<profile>/<version>/<file>" and current
	# "/okd/<profile>/<release>/<version>/<file>" (version "vN") layouts.
	location ~ "^/okd/[a-z0-9]+(?:-[a-z0-9]+)*/(?:[0-9A-Za-z][0-9A-Za-z._-]{0,127}/)?(?:v[1-9][0-9]*|[0-9a-f-]{16,64})/(?:boot[.]ipxe|agent[.]x86_64-vmlinuz|agent[.]x86_64-initrd[.]img|agent[.]x86_64-rootfs[.]img)$" {
		root /assets;
		autoindex off;
	}
	location /okd/ { return 404; }
	location / {
		root /assets;
		autoindex on;
	}

	rewrite ^/rom$ /rom/ permanent;

	location /rom {
		root /config/menus;
		index index.html;
		autoindex on;
	}

	location /status {
		stub_status;
		allow 127.0.0.1;
		deny all;
		access_log off;
	}
}

# Webapp over TLS — reverse proxy to the Node app (HTTP on loopback), with the
# WebSocket upgrade headers socket.io needs.
server {
	listen ${WEBAPP_HTTPS_PORT} ssl;
	ssl_certificate /config/tls/server.crt;
	ssl_certificate_key /config/tls/server.key;

	location / {
		proxy_pass http://127.0.0.1:${WEB_APP_PORT};
		# Match bounded Socket.IO JSON-escaped pull-secret packets over polling.
		client_max_body_size 7m;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}
}
