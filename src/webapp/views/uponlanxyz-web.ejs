//// Render Docs ////
function prettyLabel(key) {
  // Filenames use `-` as a word separator (e.g. `02-PXE-Basics.md` ->
  // `PXE-Basics`); render them as human words in the sidebar.
  return key.replace(/-/g, ' ');
}

// Stable, collision-free id for a folder collapse target (key may be `UpOnLAN.xyz`,
// `iPXE`, …). Folders are keyed by their path so nested folders stay unique.
function folderId(pathPrefix, key) {
  const slug = (pathPrefix + key).replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  return 'doc-folder-' + (slug || 'root');
}

// Explicit per-entry icons, keyed by the prettified label; anything not listed
// falls back to a folder/file glyph.
const TOC_ICONS = {
  'UpOnLAN.xyz': '🏠', 'iPXE': '🥾', 'Networks': '🌐',
  'Getting Started': '🏁', 'PXE Basics': '📡', 'Assets': '📦',
  'Overview': '📖', 'DHCP': '🔌',
  'Quick Start': '⚡', 'Menu Scripting': '📝', 'ROM Build': '💿',
  'Development': '🧱', 'Deployment': '🚀', 'Operations': '🔄',
  'CI': '🔧', 'Troubleshoot': '🐛', 'Contribute': '🤝',
};

function iconFor(label, isFolder) {
  return TOC_ICONS[label] || (isFolder ? '📁' : '📄');
}

function renderTree(tree, level = 0, pathPrefix = '') {
  const keys = Object.keys(tree).filter((k) => k !== '__file');
  let html = '';

  for (const key of keys) {
    const node = tree[key];
    const label = prettyLabel(key);
    const icon = iconFor(label, !node.__file);
    const pad = 12 + level * 16; // indent nested entries under their folder

    if (node.__file) {
      html += `<div class="bd-toc-item">
        <a href="#" class="bd-toc-link doc-link" data-doc="${node.__file}" style="padding-left:${pad}px;">${icon} ${label}</a>
      </div>`;
    } else {
      // Folder: a collapsible group header (accordion, like the menu editor).
      const id = folderId(pathPrefix, key);
      html += `<div class="bd-toc-item">
        <button type="button" class="btn btn-link btn-block text-left bd-toc-link font-weight-bold text-secondary" style="padding-left:${pad}px;" data-toggle="collapse" data-target="#${id}" aria-expanded="true" aria-controls="${id}">
          ${icon} ${label}
        </button>
        <div class="collapse show" id="${id}">
          ${renderTree(node, level + 1, pathPrefix + key + '/')}
        </div>
      </div>`;
    }
  }

  return html;
}

