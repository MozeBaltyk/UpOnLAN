          </button>
          <button class="btn btn-danger btn-sm delete-wol-btn" data-mac="${mac}">
            <span style="font-size:1.2em;">&#128465;</span>
          </button>
        </td>
      </tr>`;
    });
  } else {
    html += `<tr><td colspan="6" class="text-center">No hosts available</td></tr>`;
  }
  html += `
          </tbody>
        </table>
      </div>
    </div>
  `;
  $('#pagecontent').append(html);

  // Handle delete button click
  $('.delete-wol-btn').click(function() {
    const mac = $(this).data('mac');
    if (confirm('Delete this host?')) {
      socket.emit('deletewol', mac);
    }
  });  

  // Wake button handler
  $('.wake-wol-btn').click(function() {
    const mac = $(this).data('mac');
    socket.emit('wakewol', mac);
  });

  // Set a one-shot wake schedule
  $('.set-wol-schedule-btn').click(function() {
    const mac = $(this).data('mac');
    const value = $(this).closest('td').find('.wol-schedule-input').val();
    if (value) {
      socket.emit('updatewol', { default_mac: mac, wake_at: value });
    }
  });

  // Clear an existing schedule
  $('.clear-wol-schedule-btn').click(function() {
    const mac = $(this).data('mac');
    socket.emit('updatewol', { default_mac: mac, wake_at: null });
  });

  // Show/hide form on button click
  $('#add-wol-btn').click(function() {
    $('#add-wol-form').toggle();
    $('#wol-error').hide();
  });

  // Handle form submission
  $('#submit-wol-btn').click(function() {
    $('#wol-error').hide();
    const hostname = $('#new-wol-host').val().trim();
    const mac = $('#new-wol-mac').val().trim();
    if (!hostname) {
      $('#wol-error').text('Host name is required').show();
      return;
    }
    if (!mac) {
      $('#wol-error').text('MAC address is required').show();
      return;
    }
    const payload = { hostname: hostname, default_mac: mac };
    const ip = $('#new-wol-ip').val().trim();
    const wakeAt = $('#new-wol-wake').val().trim();
    if (ip) payload.ip = ip;
    if (wakeAt) payload.wake_at = wakeAt;
    socket.emit('addwol', payload);
    $('#new-wol-host').val('');
    $('#new-wol-mac').val('');
    $('#new-wol-ip').val('');
    $('#new-wol-wake').val('');
  });
});

//// Render VM Console (serial console via xterm.js) ////
let vmTerm = null;
let vmScrollback = '';
const VM_SCROLLBACK_MAX = 200000; // chars; drop oldest past this
let vmAutoScroll = true;
// Whether the server currently has an active serial console stream for us.
// Tab switches must NOT tear it down; only power actions / close events do.
let vmConsoleAttached = false;

function startVmConsole(force) {
  if (!force && vmConsoleAttached) return;
  vmConsoleAttached = true;
  socket.emit('vm:console:start');
}
function stopVmConsole() {
  vmConsoleAttached = false;
  socket.emit('vm:console:stop');
}

// Size the terminal to fill its container. xterm.js otherwise defaults to
// 80x24, which leaves most of the card empty (the "half console" look).
// Cell metrics come from the renderer once it has painted; fall back to a
// rough estimate before that (re-fitted on the next animation frame).
function fitVmConsole() {
  if (!vmTerm) return;
  const el = document.getElementById('vm-console');
  if (!el) return;
  const renderer = vmTerm._core && vmTerm._core._renderService;
  const dims = renderer && renderer.dimensions;
  const cellW = (dims && dims.css.cell.width) || 8;
  const cellH = (dims && dims.css.cell.height) || 16;
  const cols = Math.max(2, Math.floor(el.clientWidth / cellW));
  const rows = Math.max(1, Math.floor(el.clientHeight / cellH));
  try { vmTerm.resize(cols, rows); } catch (e) {}
}
window.addEventListener('resize', fitVmConsole);

// Module-level socket listeners (registered once, like the other pages).
function vmStateColor(state) {
  switch (state) {
    case 'running': return '#28a745';      // green
    case 'paused': return '#ffc107';       // amber
    case 'shut off':
    case 'crashed':
    case 'pmsuspended': return '#dc3545';  // red
    default: return '#6c757d';             // grey (not found / unknown)
  }
}

socket.on('vm:status', function(data) {
  let note = '';
  if (data.hasConsole === false) note = ' (no pty serial console configured)';
  if (data.state === 'not found') note = ' (VM not defined on host)';
  const stateEl = $('#vm-state');
  stateEl.empty()
    .append($('<span></span>').css({ display: 'inline-block', width: '10px', height: '10px', borderRadius: '50%', background: vmStateColor(data.state), marginRight: '6px', verticalAlign: 'middle' }))
    .append(document.createTextNode(data.name + ': ' + data.state + note));
  if (data.trustStale) {
    stateEl.append(' <span class="text-warning">— ' + (data.trustMessage || 'PXE boot trust changed — restart the VM') + '</span>');
  }
  if (data.error) showToast(data.error, 'danger');
});
socket.on('vm:action:result', function(res) {
  if (res.ok && (res.action === 'on' || res.action === 'create' || res.action === 'restart')) {
    // VM booted/created/restarted — force re-attach (the old console session
    // may have raced the destroy and not yet emitted vm:console:close).
    if (res.warning) showToast(res.warning, 'warning');
    setTimeout(function() { startVmConsole(true); }, 2000);
  } else if (res.ok && res.action === 'off') {
    stopVmConsole();
  } else if (!res.ok) {
    showToast(res.message, 'danger');
  }
});
socket.on('vm:console:data', function(data) {
  // Accumulate scrollback so it survives tab switches (terminal is recreated
  // on each render).
  vmScrollback += data;
  if (vmScrollback.length > VM_SCROLLBACK_MAX) vmScrollback = vmScrollback.slice(-VM_SCROLLBACK_MAX);
  if (vmTerm) {
    vmTerm.write(data);
    if (vmAutoScroll) vmTerm.scrollToBottom();
  }
});
socket.on('vm:console:close', function() {
  vmConsoleAttached = false; // session ended (power-off/destroy) — allow re-attach
  if (vmTerm) vmTerm.write('\r\n[console detached]\r\n');
});

function renderconsole() {
  // Dispose the xterm and drop the reference first: data arriving mid-render
  // must land only in the scrollback buffer, not a disposed terminal.
  if (vmTerm) { try { vmTerm.dispose(); } catch (e) {} vmTerm = null; }
  vmDisposeVnc();
  $('#pagecontent').empty();
  $('#pagecontent').append(`
    <div class="card">
      <div class="card-header">VM Console</div>
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-center mb-3">
          <button class="btn btn-outline-success btn-sm mr-2" onclick="vmCreate()">Create VM</button>
          <button class="btn btn-outline-danger btn-sm mr-2" onclick="vmDestroy()">Destroy VM</button>
          <button class="btn btn-outline-primary btn-sm mr-2" onclick="vmRestart()">Restart VM</button>
          <span class="mr-2"></span>
          <button class="btn btn-outline-secondary btn-sm mr-1" onclick="vmCopyConsole()" title="Copy output">Copy</button>
          <button class="btn btn-outline-secondary btn-sm mr-1" onclick="vmPasteConsole()" title="Paste from clipboard">Paste</button>
          <button class="btn btn-outline-secondary btn-sm mr-1" onclick="vmFontConsole(-1)" title="Smaller text">A-</button>
          <button class="btn btn-outline-secondary btn-sm mr-2" onclick="vmFontConsole(1)" title="Larger text">A+</button>
          <button class="btn btn-outline-info btn-sm mr-2" onclick="vmShowVnc()" title="Graphical console (VNC)">VNC</button>
          <label class="small mb-0 mr-1" title="Auto-scroll to bottom on new output">
            <input type="checkbox" id="vm-autoscroll" checked onchange="vmAutoScroll = this.checked;"> Autoscroll
          </label>
        </div>
        <div class="mb-2">
          <span id="vm-state" class="text-muted"></span>
        </div>
        <div id="vm-console" style="height:66vh; min-height:420px; background:#000;"></div>
        <div id="vm-vnc" class="d-none" style="height:66vh; min-height:420px; background:#000;"></div>
        <div class="text-muted mt-2 small">
          Serial console of the test VM. Interact with the iPXE menu via keyboard
          (arrow keys / numbers / Enter). Text only — no graphical output. Use the
          <strong>VNC</strong> button for a graphical console (GUI installers).
        </div>
      </div>
    </div>
  `);

  // Refresh VM state, but do NOT touch the serial session: tab switches just
  // recreate the xterm; the live virsh console keeps streaming.
  socket.emit('vm:status');

  vmTerm = new Terminal({
    cursorBlink: true,
    fontSize: 13,
    scrollback: 5000,
    theme: { background: '#000', foreground: '#e0e0e0' },
  });
  vmTerm.open(document.getElementById('vm-console'));
  vmTerm.onData(function(data) {
    socket.emit('vm:console:input', data);
  });
  // Restore accumulated scrollback across tab switches.
  if (vmScrollback) vmTerm.write(vmScrollback);
  // Cell metrics aren't available until the first paint; fit then (and on resize).
  requestAnimationFrame(function() { fitVmConsole(); });
  // Attach once; no-op if the session is already streaming.
  startVmConsole();
}

function vmCopyConsole() {
  const text = vmScrollback || (vmTerm ? '' : '');
  if (!text) { showToast('Console is empty', 'info'); return; }
  copyText(text);
  showToast('Copied console output', 'success');
}
function vmPasteConsole() {
  if (navigator.clipboard && navigator.clipboard.readText) {
    navigator.clipboard.readText().then(function(t) {
      socket.emit('vm:console:input', t);
    }).catch(function() { showToast('Clipboard read denied by browser', 'danger'); });
  } else {
    showToast('Clipboard paste not supported here', 'danger');
  }
}
function vmFontConsole(delta) {
  if (!vmTerm) return;
  const size = Math.min(24, Math.max(8, (vmTerm.options.fontSize || 13) + delta));
  vmTerm.options.fontSize = size;
  try { vmTerm.refresh(0, vmTerm.rows - 1); } catch (e) {}
  requestAnimationFrame(function() { fitVmConsole(); });
}

function vmCreate() {
  $('#vmFirmwareModal').modal('show');
}

function vmRestart() {
  socket.emit('vm:power', 'restart');
}

function vmDestroy() {
  if (confirm('Permanently remove the test VM? This cannot be undone.')) {
    socket.emit('vm:destroy');
  }
}

//// Graphical console (noVNC over the /novnc/ws proxy) ////
let vmRfb = null;
let vncGen = 0; // bumped on dispose so an in-flight noVNC connect is discarded

// Tear down any prior session, then ask the server for the current VNC port.
function vmShowVnc() {
  vmDisposeVnc();
  socket.emit('vm:vnc:info');
}

socket.on('vm:vnc:info', function(info) {
  if (!info || !info.port) {
    showToast('No graphical console — the VM has no VNC display (create it with the graphical option)', 'warning');
    return;
  }
  const gen = vncGen;
  const wsUrl = (window.location.protocol === 'https:' ? 'wss://' : 'ws://') +
    window.location.host + '/novnc/ws?port=' + info.port +
    (info.token ? '&token=' + encodeURIComponent(info.token) : '');

  $('#vm-console').addClass('d-none');
  $('#vm-vnc').removeClass('d-none');

  import('<%= baseurl %>public/vendor/novnc/core/rfb.js').then(function(mod) {
    if (gen !== vncGen) return; // console re-rendered while loading — drop stale connect
    const RFB = mod.default;
    vmRfb = new RFB(document.getElementById('vm-vnc'), wsUrl, {
      credentials: { password: info.password || '' },
    });
    vmRfb.scaleViewport = true;
    vmRfb.resizeSession = true;
    vmRfb.focus();
  }).catch(function(err) {
    showToast('Failed to load noVNC: ' + err.message, 'danger');
  });
});

// Dispose noVNC when the console view is re-rendered or the page navigates away.
// Bumping `gen` also abandons any connect still loading its rfb.js module.
function vmDisposeVnc() {
  vncGen++;
  if (vmRfb) { try { vmRfb.disconnect(); } catch (e) {} vmRfb = null; }
}
