#!ipxe

# Rocky Linux
# https://rockylinux.org/

isset ${dhcp-server} && set ipparam ip=dhcp || set ipparam ip=${ip}::${gateway}:${netmask}:::none nameserver=${dns}
set ipparam BOOTIF=${netX/mac} ${ipparam}

goto ${menu} ||

:rockylinux
clear osversion
set os Rocky Linux
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch x86_64 ||
iseq ${os_arch} arm64 && set os_arch aarch64 ||
menu ${os} - ${os_arch}
item 9 ${space} ${os} 9 (Latest)
item 8 ${space} ${os} 8 (Latest)
isset ${osversion} || choose osversion || goto linux_menu
echo ${cls}
set dir ${rockylinux_base_dir}/${osversion}/BaseOS/${os_arch}/os
set repo ${rockylinux_mirror}/${dir}
# Boot files come from our mirrored bundle (rocky-<ver>-<arch> in endpoints.yml);
# packages still come from the Rocky repo via inst.repo.
set url ${local_endpoint}rocky-${osversion}-${arch}/
goto boottype

:boottype
set ova ${os} ${osversion}
menu ${os} ${os_arch} boot type
item graphical ${ova} graphical installer
item text ${ova} text based installer
item rescue ${ova} rescue
item kickstart_example ${ova} kickstart ${kickstart_url}
item kickstart ${ova} set kickstart url [ ${ks_url} ]
isset ${bt} || choose bt || goto rockylinux
echo ${cls}
iseq ${bt} text && goto text ||
iseq ${bt} rescue && goto rescue ||
iseq ${bt} kickstart_example && goto kickstart_example ||
iseq ${bt} kickstart && goto kickstart ||
goto bootos_images

:graphical
set install_mode inst.graphical ||
goto bootos_images

:text
set install_mode inst.text ||
goto bootos_images

:rescue
set params inst.rescue ||
goto bootos_images

:kickstart
echo -n Specify kickstart URL for ${os} ${osversion}: && read ks_url
set params inst.ks=${ks_url} inst.noverifyssl ||
clear bt
goto boottype

:kickstart_example
# ks.cfg is served over the self-signed local HTTPS endpoint, so Anaconda has
# no trust path for it — inst.noverifyssl lets it fetch the ks (and any
# self-signed inst.repo) without validating that cert. Drop it once a real or
# internal-CA cert replaces the endpoint.
set params inst.ks=${kickstart_url} inst.noverifyssl ||
clear bt
goto bootos_images

:bootos_images
imgfree
# Our mirror saves Rocky's upstream `initrd.img` locally as plain `initrd`.
# On this pinned iPXE build, pass the kernel the initrd image name it expects
# and name the downloaded image to match.
kernel ${url}vmlinuz initrd=initrd.img inst.repo=${repo} ${install_mode} ${params} ${ipparam} ${cmdline}
initrd --name initrd.img ${url}initrd
boot
goto linux_menu

:linux_menu
clear menu
exit 0
