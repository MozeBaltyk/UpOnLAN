<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Web Application for configuring uponlan.xyz">
    <meta name="author" content="uponlan.xyz">
    <title>UpOnLan.xyz</title>
    <!-- Favicon (modern browsers need just these) -->
    <link rel="icon" type="image/png" sizes="32x32" href="<%= baseurl %>public/img/favicon/favicon-32x32.png">
    <link rel="icon" href="<%= baseurl %>public/img/favicon/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= baseurl %>public/img/favicon/apple-icon-180x180.png">
    <link rel="manifest" href="<%= baseurl %>public/img/favicon/manifest.json">
    <meta name="theme-color" content="#212529">
    <!-- Apply persisted theme before first paint to avoid a light-mode flash -->
    <script>
      (function () {
        var theme = localStorage.getItem('saved-theme');
        if (!theme) {
          theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <!-- Stylesheets -->
    <link rel="stylesheet" href="<%= baseurl %>public/vendor/css/bootstrap.min.css">
    <link rel="stylesheet" href="<%= baseurl %>public/vendor/css/docs.min.css">
    <link rel="stylesheet" href="<%= baseurl %>public/vendor/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="<%= baseurl %>public/vendor/css/logs.css">
    <link rel="stylesheet" href="<%= baseurl %>public/vendor/css/docs.css">
    <link rel="stylesheet" href="<%= baseurl %>public/vendor/css/menus.css">
    <link rel="stylesheet" href="<%= baseurl %>public/vendor/css/dark-theme.css">
    <style>
      /* Toast stack (Bootstrap 4 toasts, fixed top-right) */
      #toast-container {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 1100;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: min(90vw, 380px);
      }
      /* Navbar status chips */
      #statuschips .badge { font-weight: 500; }
      #statusbar { width: auto; min-width: 280px; max-width: 100%; }
      @media (max-width: 991.98px) {
        #statuschips, #statusbar { width: 100%; margin: 0.25rem 0; }
      }
    </style>
  </head>
  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="navbar-brand" style="cursor:pointer;" onclick="navTo('renderdash','navdash')">
        <img src="<%= baseurl %>public/img/logo.png" width="30" height="30" class="d-inline-block align-top" alt="">
        UpOnLAN.xyz
      </div>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mr-auto">
          <li class="nav-item active" id="navdash">
            <div class="nav-link" style="cursor:pointer;" onclick="navTo('renderdash','navdash')">Dashboard</div>
          </li>
          <li class="nav-item" id="navconfig">
            <div class="nav-link" style="cursor:pointer;" onclick="navTo('renderconfig','navconfig')">Menus</div>
          </li>
          <li class="nav-item" id="navlocal">
            <div class="nav-link" style="cursor:pointer;" onclick="navTo('renderlocal','navlocal')">Assets</div>
          </li>
          <li class="nav-item" id="navwol">
            <div class="nav-link" style="cursor:pointer;" onclick="navTo('renderwol','navwol')">Wake On LAN</div>
          </li>
          <li class="nav-item" id="navdoc">
            <div class="nav-link" style="cursor:pointer;" onclick="navTo('renderdoc','navdoc')">Docs</div>
          </li>
        </ul>
        <ul class="navbar-nav ml-auto align-items-lg-center">
          <li class="nav-item">
            <div id="statuschips" class="d-flex flex-wrap justify-content-end mr-lg-3"></div>
          </li>
          <li class="nav-item">
            <div id="statusbar" class="mx-lg-2"></div>
          </li>
          <li class="nav-item">
            <button class="theme-toggle" onclick="toggleTheme()" title="Toggle dark/light theme">
              <span id="theme-icon">🌙</span>
            </button>
          </li>
        </ul>
      </div>
    </nav>
    <!-- Toast notifications -->
    <div id="toast-container" aria-live="polite" aria-atomic="true"></div>
    <!-- Main page content -->
    <div id="pagecontent"></div>
    <!-- Bootstrap core JavaScript -->
    <script src="<%= baseurl %>public/vendor/js/jquery.min.js"></script>
    <script src="<%= baseurl %>public/vendor/js/popper.min.js"></script>
    <script src="<%= baseurl %>public/vendor/js/bootstrap.min.js"></script>
    <!-- Plugin JavaScript -->
    <script src="<%= baseurl %>socket.io/socket.io.js"></script>
    <script src="<%= baseurl %>public/vendor/js/ace.js"></script>
    <script src="<%= baseurl %>public/vendor/js/jquery.dataTables.min.js"></script>
    <script src="<%= baseurl %>public/vendor/js/dataTables.bootstrap4.min.js"></script>
    <script src="<%= baseurl %>public/vendor/js/chart.umd.js"></script>
    <script src="<%= baseurl %>public/vendor/js/luxon.min.js"></script>
    <script src="<%= baseurl %>public/vendor/js/chartjs-adapter-luxon.umd.min.js"></script>
    <script src="<%= baseurl %>public/vendor/js/marked.min.js"></script>
    <!-- Our JavaScript -->
    <script src="<%= baseurl %>uponlanxyz-web.js"></script>
  </body>
</html>
