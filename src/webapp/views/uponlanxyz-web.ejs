    <div id="okd-content-body" class="card-body py-3">
    <div class="d-flex align-items-center mb-3"><label for="okd-profile-list" class="mb-0"></label>
      <select id="okd-profile-list" class="form-control form-control-sm ml-3" style="max-width:260px"><option value="">Select profile…</option>${options}</select>
      <button id="okd-new" class="btn btn-outline-primary btn-sm ml-2">New</button>
      <button id="okd-delete" class="btn btn-outline-danger btn-sm ml-2" ${okdExistingId ? '' : 'disabled'}>Delete</button></div>
    <div class="${profileTab ? '' : 'd-none'}">
          <h5 class="card-title"><strong>Profiles</strong></h5>
          <div id="okd-result" class="alert py-2" style="display:none"></div>
          <div class="form-row">
            <div class="form-group col-md-2"><label for="okd-id">Profile ID</label><input id="okd-id" class="form-control form-control-sm" value="${okdAttr(p.id)}" ${okdExistingId ? 'disabled' : ''} placeholder="lab-okd"></div>
            <div class="form-group col-md-3"><label for="okd-release">Release</label><select id="okd-release" class="form-control form-control-sm"><option value="${OKD_RELEASE}">${OKD_RELEASE}</option></select></div>
            <div class="form-group col-md-2"><label for="okd-platform">Platform</label><select id="okd-platform" class="form-control form-control-sm"><option value="none" ${p.platform === 'none' ? 'selected' : ''}>none</option><option value="baremetal" ${p.platform === 'baremetal' ? 'selected' : ''}>baremetal</option></select></div>
            <div class="form-group col-md-2"><label for="okd-topology">Topology</label><select id="okd-topology" class="form-control form-control-sm"><option value="sno" ${p.topology === 'sno' ? 'selected' : ''}>sno</option><option value="compact" ${p.topology === 'compact' ? 'selected' : ''}>compact</option><option value="standard" ${p.topology === 'standard' ? 'selected' : ''}>standard</option></select></div>
            <div class="form-group col-md-2"><label for="okd-workers">Workers</label><input id="okd-workers" type="number" min="1" max="${OKD_MAX_WORKERS}" class="form-control form-control-sm" value="${p.worker_count}" ${p.topology === 'standard' ? '' : 'disabled'}></div>
          </div>
          <div class="form-row">
