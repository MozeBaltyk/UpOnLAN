    okdProfile = okdNewProfile(); okdExistingId = null; okdRevision = null; okdConfigs = null; okdConfigStatus = ''; okdJobLog = ''; okdCertificateInspection = null; okdAdditionalCertificates = []; okdMarkClean(okdProfile); okdRenderForm();
  });
  $('#okd-platform').change(function() { okdProfile = okdReadForm(); if (okdProfile.platform === 'none') { okdProfile.api_vip = ''; okdProfile.ingress_vip = ''; } okdRenderForm(); });
  $('#okd-hosts [data-host="disk_hint_type"]').change(function() {
    $(this).closest('tr').find('[data-host="disk_hint_value"]').attr('placeholder', okdDiskHintPlaceholder($(this).val()));
  });
  $('#okd-topology, #okd-workers').change(function() {
    const previousTopology = okdProfile.topology;
    const previousWorkers = okdProfile.worker_count;
    const next = okdReadForm();
    if (next.topology === 'standard' && next.worker_count < 1) next.worker_count = 1;
    const keep = okdDesiredRoles(next).length;
    const populated = next.hosts.slice(keep).some(function(host) {
      return ['hostname', 'mac', 'ipv4', 'interface', 'disk_hint'].some(function(field) { return !!host[field]; });
    });
    if (populated && !confirm('This change removes populated host rows. Continue?')) {
      next.topology = previousTopology; next.worker_count = previousWorkers;
    }
    okdProfile = next; okdFitHosts(okdProfile); okdRenderForm();
  });
  $('#okd-save').click(function() {
    if (okdExistingId && !confirm('Save regenerates BOTH YAML templates and replaces all manual YAML edits, including NMState and mirrors. Continue?')) return;
    const invalidDiskHint = $('#okd-hosts [data-host="disk_hint_value"]').filter(function() {
      const value = $(this).val().trim();
      return !value || /^(?:wwn|serial|deviceName):/.test(value);
    }).first();
    if (invalidDiskHint.length) {
      okdShowResult({ ok: false, message: 'Enter a root-device hint value only (for Device name, use /dev/sda, not deviceName:/dev/sda).' });
      invalidDiskHint.focus();
      return;
    }
    const profile = okdReadForm();
    okdPrepareProfileSave(profile);
  });
  $('#okd-delete').click(function() {
    if (!okdExistingId || !confirm('Delete profile metadata for ' + okdExistingId + '?')) return;
    socket.emit('okd:delete', { id: okdExistingId, confirmed: true }, function(result) {
      if (!result.ok) { okdShowResult(result); return; }
      okdExistingId = null; renderokd();
    });
  });
}

function renderokd() {
  okdPageActive = true;
  okdStopToolPoll(); const epoch = ++okdViewEpoch;
  okdToolStatus = null; okdSavedRelease = null; okdToolError = ''; okdGenerationReady = false;
  okdPreflight = { ready: false, errors: [{ message: 'Select and save a profile.' }] };
  $('#pagecontent').empty();
  showLoading('#pagecontent', 'Getting OKD profiles');
  socket.emit('okd:list', function(result) {
    if (!okdPageActive || epoch !== okdViewEpoch) return;
    if (!result.ok) { okdProfile = okdNewProfile(); okdProfiles = []; okdExistingId = null; okdRevision = null; okdMarkClean(okdProfile); okdRenderForm(); okdShowResult(result); return; }
    okdProfiles = result.data;
    const selectedId = okdListedProfileId(okdProfiles, okdExistingId);
    const finish = function() { okdSavedRelease = okdExistingId ? okdProfile.release : null; okdRenderForm(); okdRefreshTools(); okdRefreshJobs(); };
    if (!selectedId) { okdProfile = okdNewProfile(); okdExistingId = null; okdRevision = null; okdMarkClean(okdProfile); finish(); return; }
    socket.emit('okd:get', selectedId, function(profileResult) {
      if (!okdPageActive || epoch !== okdViewEpoch) return;
      if (!profileResult.ok) { okdProfile = okdNewProfile(); okdExistingId = null; okdRevision = null; okdMarkClean(okdProfile); okdRenderForm(); okdShowResult(profileResult); return; }
      okdProfile = okdNormalizeProfile(profileResult.data); okdExistingId = profileResult.data.id; okdRevision = profileResult.data.revision; okdConfigs = null; okdConfigStatus = ''; okdAdditionalCertificates = []; okdCertificateInspection = null; okdMarkClean(okdProfile); okdLoadAdditionalCertificates(okdProfile); finish();
    });
  });
}

